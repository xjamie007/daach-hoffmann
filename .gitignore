# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
/build
next-env.d.ts

# production image derivatives (regenerated by `npm run images`)
/public/img/generated/

# misc
.DS_Store
*.pem
/coverage

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env
.env
.env*.local

# typescript
*.tsbuildinfo

# editor / agent scratch
.impeccable/live/

# local agent tooling — vendored skills, hooks and agent definitions.
# Not part of the website: ~10 MB of development scaffolding, and
# settings.local.json is machine-local by convention. `skills-lock.json`
# stays tracked, so what was installed is still recorded.
/.claude/*
!/.claude/launch.json
/.agents/
/.codex/
/.impeccable/

# legacy redirect documents, written into public/ by scripts/build-redirects.mjs
# on every build. Their content depends on NEXT_PUBLIC_BASE_PATH, so a tracked
# copy is only ever right for one deploy target and dirties the tree on every
# build for the other. The script and its URL list are tracked; the output is
# regenerated by `npm run build`, before Next copies public/ into out/.
/public/*_luxembourg.html
/public/cheminee_toiture_hobscheid.html
