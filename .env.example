# Kopieren nach .env.local und ausfüllen. .env.local ist gitignored.

# Absolute Basis-URL der Produktivseite. Wird für canonical, hreflang, Sitemap
# und JSON-LD gebraucht — ein relativer Wert ist an all diesen Stellen still falsch.
NEXT_PUBLIC_SITE_URL=https://www.daach-hoffmann.lu

# Leer lassen bei eigener Domain. Bei einem GitHub-Pages-Projektsite auf
# "/<repository>" setzen, sonst laufen alle Asset-Pfade ins Leere.
NEXT_PUBLIC_BASE_PATH=

# "static" (Vorgabe) baut nach ./out und läuft auf jedem Dateihost.
# "server" behält die Node-Laufzeit: Server Actions, Bildoptimierung,
# Middleware und echte 301-Weiterleitungen. Siehe BUILD-STATUS.md.
NEXT_PUBLIC_DEPLOY_TARGET=static

# --- Phase 5, Anfrageformular -------------------------------------------
# Endpunkt, der die Anfrage entgegennimmt. Auf dem statischen Ziel eine
# Supabase Edge Function; auf dem Server-Ziel ungenutzt, dort läuft die
# Server Action.
NEXT_PUBLIC_INQUIRY_ENDPOINT=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Nur serverseitig. Niemals mit NEXT_PUBLIC_ präfixen.
SUPABASE_SERVICE_ROLE_KEY=

RESEND_API_KEY=
# Absender muss eine bei Resend verifizierte Domain sein.
INQUIRY_MAIL_FROM=anfrage@daach-hoffmann.lu
INQUIRY_MAIL_TO=info@daach-hoffmann.lu
